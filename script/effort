#!/bin/sh
# script/effort: what a lane actually spent, from the session records rather than from a tally.
#
#     script/effort                 # every branch seen, this machine, newest sessions first
#     script/effort --branch NAME   # one branch
#     script/effort --days 7        # only sessions touched in the last N days
#     script/effort --totals        # one line: session versus subagent split
#
# Name: provisional, minted 2026-09-22 by the maintainer. A noun for the thing measured, matching
# `script/metrics` and `script/bench` rather than naming the mechanism. Refused `tokens`, which
# names one unit and would be wrong the day a second one matters; refused `cost`, which implies
# money where a subscription has no per-token price; refused `session-spend`, which is the same
# objection with a hyphen. calef names scripts; expect this to change.
#
# **Why this exists.** Every figure this project has quoted about its own machine cost has been a
# hand tally: a maintainer adding up what subagents reported in their completion notices. That
# misses the session's own consumption entirely, which is the expensive half, and it was wrong by a
# large multiple on 2026-09-22 when calef checked it against the real number.
#
# **The join is already on disk and nobody was reading it.** Claude Code writes one JSON line per
# message under `~/.claude/projects/<slug>/<session>.jsonl`, and each assistant record carries
# `gitBranch`, `isSidechain` and a full `usage` block. A lane's branch is named for its milestone,
# so branch is the join from machine effort to the work it paid for.
#
# **What it measures, and what it cannot.** These records hold the session's own consumption and
# nothing else: five session files on this machine carry zero isSidechain records, so a subagent's
# usage never reaches them. It arrives only in a completion notice, which is where every previous
# tally came from. So this is the missing half rather than the whole.
#
# **Cache accounting is the whole difficulty.** A typical record reads input_tokens 2, cache_read
# 29366, cache_creation 40859: almost nothing is fresh. Summing cache reads as if they were input
# counts the same context once per turn, and produced a first answer of 14.9 BILLION tokens, which
# is what a wrong instrument looks like when it is confident. So the three are reported separately
# and the billed column applies the published multipliers: a cache write costs 1.25x an input
# token, a cache read 0.1x.
#
# **Records repeat.** The same message appears more than once, so they are deduplicated by message
# id; without that the totals roughly triple.
#
# # BUGS
#
# - **Cache reads are counted at face value.** A cached input token is billed at a fraction of a
#   fresh one, and this prints raw counts rather than a price, because the subscription has no
#   per-token price to apply. Read the columns as effort, never as dollars.
# - **It sees only this machine.** Sessions on another machine have their own records.
# - **A branch is a coarse join.** Several lanes can share a branch and one lane can span branches,
#   so a figure here is the branch's total rather than a milestone's.
# - **Records are not durable.** They live outside the repository and nothing backs them up, which
#   is why the capture this replaces was lost for the project's first ten weeks.
set -eu

dir="${CLAUDE_PROJECTS_DIR:-$HOME/.claude/projects}"
slug=$(pwd | sed 's|/|-|g')
[ -d "$dir/$slug" ] || { echo >&2 "effort: no session records at $dir/$slug"; exit 1; }

exec python3 - "$dir/$slug" "$@" <<'PYEOF'
import json, os, sys, time

root = sys.argv[1]
args = sys.argv[2:]
want_branch = args[args.index("--branch") + 1] if "--branch" in args else None
days = float(args[args.index("--days") + 1]) if "--days" in args else None
totals_only = "--totals" in args
cutoff = time.time() - days * 86400 if days else None

seen = set()
rows = {}
for name in sorted(os.listdir(root)):
    if not name.endswith(".jsonl"):
        continue
    path = os.path.join(root, name)
    if cutoff and os.path.getmtime(path) < cutoff:
        continue
    with open(path, errors="replace") as handle:
        for line in handle:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if rec.get("type") != "assistant":
                continue
            msg = rec.get("message") or {}
            usage = msg.get("usage") or {}
            if not usage:
                continue
            key = msg.get("id")
            if key:
                if key in seen:
                    continue
                seen.add(key)
            branch = rec.get("gitBranch") or "(no branch)"
            if want_branch and branch != want_branch:
                continue
            got = rows.setdefault(branch, [0, 0, 0, 0, 0])
            got[0] += usage.get("input_tokens") or 0
            got[1] += usage.get("cache_creation_input_tokens") or 0
            got[2] += usage.get("cache_read_input_tokens") or 0
            got[3] += usage.get("output_tokens") or 0
            got[4] += 1

if not rows:
    print("effort: no records matched")
    raise SystemExit


def billed(v):
    return v[0] + v[1] * 1.25 + v[2] * 0.1 + v[3]


if totals_only:
    agg = [sum(v[i] for v in rows.values()) for i in range(5)]
    print("effort: the session's own consumption, %s messages over %d branch(es)"
          % (format(agg[4], ","), len(rows)))
    print("  fresh input  %9.2fM" % (agg[0] / 1e6))
    print("  cache writes %9.2fM   (billed at 1.25x)" % (agg[1] / 1e6))
    print("  cache reads  %9.2fM   (billed at 0.1x)" % (agg[2] / 1e6))
    print("  output       %9.2fM" % (agg[3] / 1e6))
    print("  billed-equivalent %.2fM tokens" % (billed(agg) / 1e6))
    print("  Subagent usage is NOT here: it reaches only a completion notice.")
    raise SystemExit

print("%-44s%10s%10s%8s%7s" % ("branch", "billed", "reads", "out", "msgs"))
for branch, v in sorted(rows.items(), key=lambda kv: -billed(kv[1]))[:20]:
    print("%-44s%9.2fM%9.1fM%7.2fM%7d"
          % (branch[:44], billed(v) / 1e6, v[2] / 1e6, v[3] / 1e6, v[4]))
PYEOF
