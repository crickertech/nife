#!/bin/sh
# script/update: bring the project up to date after fetching new code.
#
# Re-resolves dependencies (the pinned toolchain can change from one checkout to the next) and
# rebuilds for the current tree. See notes/scripts.md.
#
# Name: ratified 2026-07-22 by adopting Scripts to Rule Them All. The canonical set keeps its
# standard names even where a more descriptive word exists, because the entire value is that the
# command is the same in every repository that follows the pattern (design/naming.md).

set -e
cd "$(dirname "$0")/.."

# This project's own QEMU, if `script/ci-qemu` has built one (helpers/qemu-path.sh says why
# PATH is the mechanism). A no-op on macOS and on any machine without that prefix.
. helpers/qemu-path.sh

script/bootstrap

echo "==> Rebuilding for the current checkout"
cargo xtask build

echo "==> Update complete"
