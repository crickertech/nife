#!/bin/sh
# script/bench: the performance microbenchmarks (milestone 21). Two instruments:
#
#   script/bench             deterministic icount counts (TCG); the regression currency
#   script/bench --check     diff against bench/baseline-aarch64.txt; FAILS on >10% drift
#   script/bench --save      rewrite the baseline (do it in the commit that moved the numbers)
#   script/bench --real      HVF: natively on the Apple Silicon core; per-core magnitudes, no gating
#   script/bench --real --smp  HVF on 4 harts; adds the multi-hart throughput bench (smp_throughput)
#                              and, with a RedoxFS disk attached, the filesystem ones: fs_read and
#                              milestone 38's four throughput phases (fs_seq_read and friends)
#
# --real is single-hart by default so the primitive magnitudes are per-core (the cross-OS comparison
# reads them that way); --smp boots the whole machine for the aggregate-throughput bench.
# See design/roadmap/21-benchmarks.md and notes/benchmarks.md.
#
# Name: unrecorded. Introduced 2026-07-23 with milestone 21. It is not one of the Scripts to Rule
# Them All names and nothing records the choice; `bench/` is also a directory holding the committed
# baselines, so the word does two jobs in this tree.
#
# BUGS
#
#   - **The EXAMPLES above name one of three architectures.** `--riscv` and `--x86` both exist
#     (`cargo xtask bench --help`, and `bench_riscv` / `bench_x86` in xtask), each gates against its
#     own `bench/baseline-<arch>.txt`, and CI runs `--riscv --check` on every pull request. None of
#     that is discoverable from this header, which is the FreeBSD standard's own test: a page
#     without the worked example has not finished explaining itself. Left as a record rather than
#     fixed here because the sweep that found it was not the lane to change three architectures'
#     documentation; see notes/architecture-list-sweep.md.

set -e
cd "$(dirname "$0")/.."
exec cargo xtask bench "$@"
