#!/bin/sh
# script/gates: run every gate a pull request must pass, in one command.
#
# Why this exists: the gates are three separate scripts, and on 2026-08-03 a change was pushed after
# running two of them. The third, `script/fmt --check`, then failed in CI for a reason that had
# nothing to do with the change, which is the most expensive kind of red check: it costs a full CI
# cycle and a human deciding whether the failure is real. Three commands is two too many to remember
# at the moment you are about to push.
#
# What it runs, and why only these. These are the checks a developer can run locally in
# minutes and that gate every pull request. Deliberately NOT the whole CI surface: `script/verify`
# (Kani, ~47 minutes), `script/cpu-matrix` (five QEMU CPU models), `script/fuzz`, `script/coverage`,
# `script/bench` and `script/supply-chain` all belong in CI, and a wrapper that ran them is a wrapper
# nobody would use. A gate people skip is not a gate.
#
# Cheapest first, so a formatting slip costs twenty seconds rather than ten minutes. See
# notes/scripts.md.
#
# Name: unrecorded. Introduced 2026-08-03 as one command for the three a pull request must pass.

set -e
cd "$(dirname "$0")/.."

case "$1" in
    "") ;;
    *)
        echo "script/gates: unknown argument '$1' (it takes none)" >&2
        echo "  To FORMAT rather than check, run script/fmt. This script never writes." >&2
        exit 2
        ;;
esac

# `--check` rather than a plain format, deliberately. This script is a question, not an edit: it must
# be safe to run against a tree you are about to push, and a wrapper that silently rewrote your files
# would be a surprising thing to have run. `script/fmt` with no argument is the one that writes.
echo "==> script/fmt --check"
script/fmt --check

echo
echo "==> script/lint"
script/lint

# The shipped kernel images obey W^X (milestone 208). Seconds against a warm target directory, and
# it goes above the two QEMU legs on the cheapest-first rule; it builds all three kernels, which
# `script/test` would build anyway for the legs below.
#
# It is here rather than inside `script/test` because it is a property of the ARTIFACT rather than
# of a boot: no suite running inside a guest can see its own program headers, and the guest that
# could tell you is the one that already failed to start. The x86_64 image carried an RWX segment
# from the port until milestone 208, through every gate in this file, for exactly that reason.
echo
echo "==> script/image-permissions"
script/image-permissions

# The instruction-count instrument (milestone 78), here since milestone 62 gave it a claim the
# suite no longer makes (2026-08-18). `script/test` used to carry two wall-clock timer assertions
# that were the last things in this tree trying to say "the handler keeps up" from inside a guest
# that cannot see the host; both were dispositioned, and the claim now lives only here. A gate that
# does not run the instrument owning a claim is a gate that has quietly dropped it.
#
# It belongs in this list rather than in `script/test` for the reason notes/instruction-clock.md
# gives at length: `-icount` gives every vCPU one shared virtual clock, so a suite run under it
# would silently stop proving every cross-core property it exists for. That argument is about a
# boot mode, not about a command, and this script is a list of commands.
#
# About seven seconds for both ISAs against this script's several minutes, so it goes above
# `script/test` on the cheapest-first rule the header states.
echo
echo "==> script/icount"
script/icount

echo
echo "==> script/test"
script/test

# The silicon leg (milestone 81). Everything above ran under TCG, which emulates every instruction:
# a machine with no real caches, no real reordering, and a scheduler QEMU round-robins between
# vCPUs. Hypervisor.framework runs the same kernel at guest EL1 on the physical Apple Silicon core,
# four vCPUs on four host threads at once, and that is a genuinely different machine to be correct
# on. It found a scheduler test asserting against a yield count on its first run.
#
# It lives here rather than in a workflow because GitHub's hosted macOS arm64 runners are themselves
# virtual machines with no nested virtualization, so HVF does not exist there. This is the one
# command a person runs before pushing, so this is where the leg reaches a real core.
#
# aarch64 only, and that is the honest name for it: HVF runs the host's own ISA, and riscv64 has no
# equivalent until the board lands.
echo
echo "==> script/test --hvf (the aarch64 suite on the physical core)"
hvf_missing=""
if [ "$(uname -s)" != "Darwin" ]; then
    hvf_missing="this host is not macOS"
elif [ "$(uname -m)" != "arm64" ]; then
    hvf_missing="this host is not Apple Silicon"
elif [ "$(sysctl -n kern.hv_support 2>/dev/null)" != "1" ]; then
    hvf_missing="Hypervisor.framework is unavailable (kern.hv_support is not 1; a VM, or entitlements)"
elif ! qemu-system-aarch64 -accel help 2>/dev/null | grep -q '^hvf$'; then
    hvf_missing="the QEMU on PATH was built without the hvf accelerator"
else
    # The four conditions above ask whether HVF exists. This one asks whether QEMU will start the
    # machine the runner actually configures, which is a different question and the one that was
    # being answered by a crash (milestone 222). On QEMU 11.1.1 it will not: HVF refuses GICv2, and
    # `kernel/src/drivers/gic.rs` speaks GICv2 only, so the leg has no version of the machine it can
    # run on. Asking the runner rather than testing a QEMU version keeps the machine string in one
    # place; see the probe in scripts/qemu-runner-aarch64.sh.
    if ! hvf_refusal="$(NIFE_PROBE=1 NIFE_ACCEL=hvf scripts/qemu-runner-aarch64.sh 2>/dev/null)"; then
        hvf_missing="QEMU will not start the machine this leg needs. It said: $hvf_refusal. The kernel drives GICv2 only (kernel/src/drivers/gic.rs, and the BUGS section of notes/interrupts.md), so there is no GIC version this QEMU and this kernel both accept"
    fi
fi

# **Skip LOUDLY.** A silent omission would let a transcript from a Linux CI runner read exactly like
# one from this laptop, and the whole point of the leg is that those two are not the same evidence.
# One line, naming what did not run and why, so nobody has to infer it from an absence.
if [ -n "$hvf_missing" ]; then
    echo "gates: SKIPPED the HVF leg ($hvf_missing). NO code in this run executed on a physical core; every test above ran under TCG emulation."
else
    script/test --hvf
fi

echo
if [ -n "$hvf_missing" ]; then
    echo "gates: fmt, lint, image-permissions, icount and test all pass (TCG only; the HVF leg was skipped)"
else
    echo "gates: fmt, lint, image-permissions, icount and test all pass, the aarch64 suite twice (TCG and the physical core)"
fi
