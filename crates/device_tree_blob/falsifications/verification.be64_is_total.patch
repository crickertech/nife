Falsifies `device_tree_blob::verification::be64_is_total`.

The same defect as `be32`'s, one function along: the checked add going back to a bare one, so a
near-`usize::MAX` `at` overflows and panics before `bytes.get` runs. `be64` never carried the
comment `be32` does, but the hardening is the same edit and the same reason.

Expected to fail: `attempt to add with overflow`, at the `let end = at + 8;` line, for any `at`
Kani picks near `usize::MAX`.

diff --git a/crates/device_tree_blob/src/lib.rs b/crates/device_tree_blob/src/lib.rs
index 6b3324864..39c758b8b 100644
--- a/crates/device_tree_blob/src/lib.rs
+++ b/crates/device_tree_blob/src/lib.rs
@@ -118,7 +118,7 @@ fn be32(bytes: &[u8], at: usize) -> Result<u32, Error> {
 }

 fn be64(bytes: &[u8], at: usize) -> Result<u64, Error> {
-    let end = at.checked_add(8).ok_or(Error::Truncated)?;
+    let end = at + 8;
     let slice = bytes.get(at..end).ok_or(Error::Truncated)?;
     Ok(u64::from_be_bytes(slice.try_into().unwrap()))
 }
