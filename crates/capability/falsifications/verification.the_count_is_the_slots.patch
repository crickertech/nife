index 89ae29da..12ebc2c6 100644
--- a/crates/capability/src/lib.rs
+++ b/crates/capability/src/lib.rs
@@ -438,7 +438,7 @@ impl<O: Copy, const N: usize> CapabilityTable<O, N> {
                 freed += 1;
             }
         }
-        self.shrank(freed);
+        let _ = freed;
