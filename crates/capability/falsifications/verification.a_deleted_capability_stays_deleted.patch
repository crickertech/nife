     pub fn delete(&mut self, slot: u64) -> Result<(), Error> {
         let s = self.slots.get_mut(slot as usize).ok_or(Error::NoSuchSlot)?;
-        s.take().ok_or(Error::NoSuchSlot)?;
+        s.as_ref().ok_or(Error::NoSuchSlot)?;
         self.shrank(1);
         Ok(())
