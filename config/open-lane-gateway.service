# The open-weight lane gateway, as a service on cordoba.
#
#     sudo cp config/open-lane-gateway.service /etc/systemd/system/
#     sudo systemctl edit open-lane-gateway     # put the two keys in an override, not in git
#     sudo systemctl enable --now open-lane-gateway
#
# **Why cordoba rather than patagonia.** It is always on, where a laptop is not, and a gateway that
# sleeps with the lid leaves every other host failing on a connection error rather than a gate
# failure. It also keeps the OpenRouter key on one machine instead of copied to each. And it spends
# nothing that matters: LiteLLM runs no model, so against cordoba's 3.6 GB free it is a translator
# rather than a load, while patagonia's 16 GB is the thing that actually caps the lane count.
#
# **Leave it on loopback and let Tailscale expose it.** The gateway holds an OpenRouter key, so the
# strongest available arrangement is that it never binds a network interface: an interface that
# appears later, or a firewall rule that is wrong later, then cannot reach it at all.
#
#     tailscale serve --bg --https=4000 http://127.0.0.1:4000
#
# `tailscale serve` is tailnet-only by definition and provisions TLS. **`tailscale funnel` is the
# one that publishes to the internet and must never be used for this.** Tailscale ACLs then decide
# which tailnet nodes may reach it, and they are the authorization: there is no gateway password.

[Unit]
Description=LiteLLM gateway: Anthropic /v1/messages translated to OpenRouter
Documentation=https://github.com/crickertech/nife/blob/main/notes/open-model-lanes.md
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=exec
User=calef
WorkingDirectory=/home/calef/nife
# Put OPENROUTER_API_KEY here, via `systemctl edit`, so it lives in /etc rather than in a
# repository that is public. There is no second secret: calef ruled on 2026-09-22 that the tailnet
# is the boundary and the key's own spend limit is the backstop. OPEN_LANE_HOST is deliberately not
# set either: the default is loopback, and `tailscale serve` is what makes it reachable.
EnvironmentFile=-/etc/open-lane-gateway.env
ExecStart=/home/calef/nife/helpers/open-lane-gateway.sh
Restart=on-failure
RestartSec=10
# It holds an API key and serves a network. Give it nothing it does not need.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/calef/.cache

[Install]
WantedBy=multi-user.target
